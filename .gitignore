# local environments
.venv*/
__pycache__/

# local state and caches (re-created by the scripts)
**/data/cache/
**/data/state.json
**/data/spend.json

# raw call log: full prompts and answers; publish a cleaned extract instead
**/data/calls.jsonl

# never commit keys
.env
*.key

# run logs (may contain local paths)
*.log

# local W&B run folders written by the training client (the runs themselves live in Forge)
**/wandb/

# local ART client cache (trajectories and state; the runs themselves live in Forge)
**/.art/
